# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (SQLite with Prisma - zero installation required)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Set to 'openai' to use live OpenAI models, or 'simulation' for offline deterministic agent
AI_PROVIDER=simulation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safety & Compliance Guardrails
ENABLE_ANTI_HALLUCINATION_GUARD=true
RED_FLAG_TRIAGE_OVERRIDE=true
LOG_LEVEL=info
